---
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Portfolio de Leonardo Bringas, estudiante y programador de Florencio Varela, Buenos Aires. HTML, CSS, JavaScript, Astro y Python."
    />
    <meta name="author" content="Leonardo Bringas" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta
      property="og:title"
      content="Leonardo Bringas — Estudiante y Programador"
    />
    <meta
      property="og:description"
      content="Portfolio de Leonardo Bringas, estudiante y programador de Florencio Varela, Buenos Aires."
    />
    <meta name="twitter:card" content="summary" />
    <meta
      name="twitter:title"
      content="Leonardo Bringas — Estudiante y Programador"
    />
    <meta
      name="twitter:description"
      content="Portfolio de Leonardo Bringas, estudiante y programador de Florencio Varela, Buenos Aires."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --font-primary: "Geist", system-ui, sans-serif;
    --font-secondary: "Geist", system-ui, sans-serif;
    --font-mono:
      "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
    /* Emil: curvas con punch, no las easings planas por defecto */
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
    --ease-drawer: cubic-bezier(0.32, 0.72, 0, 1);
  }
  html {
    font-family: var(--font-primary);
    background: #fff;
    letter-spacing: 0.025rem;
  }
  body,
  figure {
    margin: 0;
    padding: 0;
  }
  body {
    font-size: 14px;
  }

  a {
    text-decoration: none;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  *,
  *::after,
  *::before {
    box-sizing: border-box;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family: var(--font-secondary);
  }

  p {
    color: #666;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }

  @page {
    margin: 0;
  }

  @media print {
    .no-print {
      display: none;
    }
  }

  .print {
    display: none;
  }
  @media print {
    .print {
      display: block;
    }
  }
</style>
