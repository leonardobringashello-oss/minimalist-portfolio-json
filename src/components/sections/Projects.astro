---
import Section from "@/components/Section.astro";

import { projects } from "@cv";
---

<Section title="Proyectos" id="proyectos">
  <ul>
    {
      projects.map(({ url, description, highlights, name, isActive }) => {
        return (
          <li>
            <article>
              <header>
                <h3>
                  <a href={url} title={`Ver el proyecto ${name}`}>
                    {name}
                  </a>
                  {isActive && <span>&bull;</span>}
                </h3>
                <p>{description}</p>
              </header>

              <footer>
                <ul>
                  {highlights.map((highlight) => {
                    return <li>{highlight}</li>;
                  })}
                </ul>
              </footer>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  article {
    border-radius: 8px;
    border: 1px solid #f2f2f2;
    gap: 19px;
    display: flex;
    flex-direction: column;
    padding: 16px;
    height: 100%;
    background: #fff;
    transition:
      transform 200ms var(--ease-out),
      border-color 200ms ease,
      box-shadow 200ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    li:hover article {
      transform: translateY(-2px);
      border-color: #e7e7e7;
      box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.18);
    }
  }
  li:active article {
    transform: scale(0.99);
  }
  article header {
    flex: 1;
  }
  article h3 {
    margin-bottom: 5px;
  }
  article a {
    color: #111;
    text-decoration: none;
    transition: color 160ms ease;
    text-underline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    article a:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
      color: #000;
    }
  }
  article p {
    font-size: 0.76rem;
    line-height: 1.5;
  }
  header h3 span {
	color: rgb(0, 167, 64);
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    font-size: 0.7rem;
  }
  footer span {
    border-radius: 6px;
    background: #eee;
    color: black;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    display: inline-flex;
  }
  @media (prefers-reduced-motion: reduce) {
    article,
    article a {
      transition-duration: 0.01ms;
    }
    li:hover article,
    li:active article {
      transform: none;
      box-shadow: none;
    }
  }
  @media print {
    li:hover article,
    li:active article {
      transform: none;
      box-shadow: none;
    }
  }
</style>
